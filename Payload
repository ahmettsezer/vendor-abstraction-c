/* payload.h — the platform's contract: names no payload type */
#include <stdint.h>
#define N_STATIONS 4u

typedef enum { PL_EMPTY = 0, PL_DROP_TANK, PL_SENSOR_POD, PL_UNKNOWN, PL_COUNT } payload_id_t;

typedef float    (*mass_fn_t)(uint32_t station);    /* typedefs, so const lands on the pointer */
typedef uint32_t (*bit_fn_t)(uint32_t station);
typedef struct {
    mass_fn_t mass_kg;
    bit_fn_t  bit_ok;
} payload_ops_t;

float    payload_mass_kg(uint32_t s);               /* consumers call these */
uint32_t payload_bit_ok(uint32_t s);
void     payload_bind(uint32_t s, payload_id_t id); /* the inventory manager calls this, at a frame boundary */


/* tank.c — vendor A: knows the contract, keeps its own state per station */
static float tank_fuel_kg[N_STATIONS];
float    tank_mass_kg(uint32_t s) { return 120.0f + tank_fuel_kg[s]; }
uint32_t tank_bit_ok(uint32_t s)  { return (tank_fuel_kg[s] >= 0.0f) ? 1u : 0u; }

/* pod.c — vendor C */
float    pod_mass_kg(uint32_t s) { (void)s; return 200.0f; }
uint32_t pod_bit_ok(uint32_t s)  { (void)s; return 1u; }


/* integration.c — the integrator's glue: the closed set of targets, as a const table */
static float    no_mass(uint32_t s)  { (void)s; return 0.0f; }
static uint32_t bit_pass(uint32_t s) { (void)s; return 1u; }
static uint32_t bit_flag(uint32_t s) { (void)s; return 0u; }        /* UNKNOWN: flag the station */

static const payload_ops_t OPS[PL_COUNT] = {                        /* const: fixed at build time, in ROM */
    [PL_EMPTY]      = { no_mass,      bit_pass    },
    [PL_DROP_TANK]  = { tank_mass_kg, tank_bit_ok },
    [PL_SENSOR_POD] = { pod_mass_kg,  pod_bit_ok  },
    [PL_UNKNOWN]    = { no_mass,      bit_flag    },
};

static uint8_t type_of[N_STATIONS] = { PL_UNKNOWN, PL_UNKNOWN, PL_UNKNOWN, PL_UNKNOWN };   /* the only thing that moves */

void payload_bind(uint32_t s, payload_id_t id)
{
    if (s < N_STATIONS) {
        type_of[s] = (uint8_t)((id < PL_COUNT) ? id : PL_UNKNOWN);
    }
}

static uint32_t row_of(uint32_t s)                                   /* always a valid row */
{
    uint32_t id = (uint32_t)PL_UNKNOWN;
    if (s < N_STATIONS) {
        id = type_of[s];
    }
    return (id < (uint32_t)PL_COUNT) ? id : (uint32_t)PL_UNKNOWN;
}

float    payload_mass_kg(uint32_t s) { return OPS[row_of(s)].mass_kg(s); }
uint32_t payload_bit_ok(uint32_t s)  { return OPS[row_of(s)].bit_ok(s); }


/* weight_balance.c — a consumer: knows the contract only */
float total_payload_mass_kg(void)
{
    float total = 0.0f;
    for (uint32_t s = 0u; s < N_STATIONS; s++) {
        total += payload_mass_kg(s);
    }
    return total;
}
