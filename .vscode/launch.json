{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug constConfig (const config via Init)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/demo_constConfig.exe",
            "args": [],
            "cwd": "${workspaceFolder}/constConfig",
            "stopAtEntry": true,
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "build constConfig",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
