{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug variant 0 - runtime register (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/demo0.exe",
            "args": [],
            "cwd": "${workspaceFolder}/variant0_runtimeReg",
            "stopAtEntry": true,
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "build variant0 (debug)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
