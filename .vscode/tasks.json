{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir build",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if not exist build mkdir build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build constConfig",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "-Iintegrator",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_constConfig.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/constConfig"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/constConfig"
                ]
            },
            "group": "build"
        },
        {
            "label": "build switchDispatch",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/ModuleMgr_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_switch.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/switchDispatch"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/switchDispatch"
                ]
            },
            "group": "build"
        },
        {
            "label": "build fleetConfig",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-IfleetMgr",
                "-Ivehicles/toyota",
                "-Ivehicles/ford",
                "-Ivehicles/man",
                "-Ivehicles/volvo",
                "-Iintegrator",
                "fleetMgr/FleetMgr.c",
                "vehicles/toyota/Toyota.c",
                "vehicles/ford/Ford.c",
                "vehicles/man/Man.c",
                "vehicles/volvo/Volvo.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_fleet.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/fleetConfig"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/fleetConfig"
                ]
            },
            "group": "build"
        },
        {
            "label": "build payloadConfig",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-Iplatform",
                "-Ipayloads/tank",
                "-Ipayloads/pod",
                "-IinventoryMgr",
                "-Iconsumers",
                "payloads/tank/tank.c",
                "payloads/pod/pod.c",
                "integrator/integration.c",
                "inventoryMgr/inventory_mgr.c",
                "consumers/weight_balance.c",
                "integrator/main.c",
                "-o",
                "../build/demo_payload.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/payloadConfig"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/payloadConfig"
                ]
            },
            "group": "build"
        },
        {
            "label": "build fleetConfigA",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-IfleetMgr",
                "-Ivehicles/toyota",
                "-Ivehicles/ford",
                "-Ivehicles/man",
                "-Ivehicles/volvo",
                "-Iintegrator",
                "fleetMgr/FleetMgr.c",
                "vehicles/toyota/Toyota.c",
                "vehicles/ford/Ford.c",
                "vehicles/man/Man.c",
                "vehicles/volvo/Volvo.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_fleetA.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/fleetConfigA"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/fleetConfigA"
                ]
            },
            "group": "build"
        },
        {
            "label": "build fleetConfigB",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-IfleetMgr",
                "-Ivehicles/toyota",
                "-Ivehicles/ford",
                "-Ivehicles/man",
                "-Ivehicles/volvo",
                "-Iintegrator",
                "fleetMgr/FleetMgr.c",
                "vehicles/toyota/Toyota.c",
                "vehicles/ford/Ford.c",
                "vehicles/man/Man.c",
                "vehicles/volvo/Volvo.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_fleetB.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/fleetConfigB"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/fleetConfigB"
                ]
            },
            "group": "build"
        },
        {
            "label": "build all",
            "dependsOn": [
                "build constConfig",
                "build switchDispatch",
                "build fleetConfig",
                "build payloadConfig",
                "build fleetConfigA",
                "build fleetConfigB"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}