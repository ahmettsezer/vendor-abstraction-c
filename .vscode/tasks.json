{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir build",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if not exist build mkdir build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build runtimeRegister",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "-Iintegrator",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_runtimeReg.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/runtimeRegister"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/runtimeRegister"
                ]
            },
            "group": "build"
        },
        {
            "label": "build runtimeRegisterConst",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "-Iintegrator",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_runtimeRegConst.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/runtimeRegisterConst"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/runtimeRegisterConst"
                ]
            },
            "group": "build"
        },
        {
            "label": "build constConfig",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "-Iintegrator",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_constConfig.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/constConfig"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/constConfig"
                ]
            },
            "group": "build"
        },
        {
            "label": "build switchDispatch",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/vendorA",
                "-Ivendors/vendorB",
                "moduleMgr/ModuleMgr.c",
                "vendors/vendorA/VendorA.c",
                "vendors/vendorB/VendorB.c",
                "integrator/ModuleMgr_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_switch.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/switchDispatch"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/switchDispatch"
                ]
            },
            "group": "build"
        },
        {
            "label": "build fleetConfig",
            "type": "process",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-O0",
                "-g3",
                "-ImoduleMgr",
                "-Ivendors/toyota",
                "-Ivendors/man",
                "-Ivendors/volvo",
                "-Iintegrator",
                "moduleMgr/ModuleMgr.c",
                "vendors/toyota/Toyota.c",
                "vendors/man/Man.c",
                "vendors/volvo/Volvo.c",
                "integrator/Integrator_Cfg.c",
                "integrator/main.c",
                "-o",
                "../build/demo_fleet.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/fleetConfig"
            },
            "dependsOn": "mkdir build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/fleetConfig"
                ]
            },
            "group": "build"
        },
        {
            "label": "build all",
            "dependsOn": [
                "build runtimeRegister",
                "build runtimeRegisterConst",
                "build constConfig",
                "build switchDispatch",
                "build fleetConfig"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}